{
  "name": "medicore",
  "version": "1.0.0",
  "description": "MediCore Healthcare Management System",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "bundle-api": "cd backend && pyinstaller --onefile --name medicore-api main.py",
    "dist:win": "npm run build && npm run bundle-api && electron-builder --win",
    "dist:linux": "npm run build && npm run bundle-api && electron-builder --linux",
    "dist:all": "npm run build && npm run bundle-api && electron-builder --win --linux",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.288.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "recharts": "^2.9.0",
    "tailwind-merge": "^1.14.0",
    "zustand": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.8.7",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.1",
    "electron": "^27.0.0",
    "electron-is-dev": "^2.0.0",
    "electron-builder": "^24.6.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "^4.4.11",
    "wait-on": "^7.0.1"
  }
}
